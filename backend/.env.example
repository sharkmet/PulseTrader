# ─────────────────────────────────────────────────────────────────────────────
# PulseTrader Backend — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Required for AI features ──────────────────────────────────────────────────
# Get yours at https://console.anthropic.com
# If not set, AI deep-dive and Claude sentiment are disabled (VADER used instead).
ANTHROPIC_API_KEY=

# ── Optional — NewsAPI (free tier: 100 req/day) ───────────────────────────────
# Get yours at https://newsapi.org/register
# If not set, yfinance news is used as the only source.
NEWS_API_KEY=

# ── Optional — CoinGecko Demo key ────────────────────────────────────────────
# Bumps rate limit with better uptime. Still free.
# Get yours at https://www.coingecko.com/en/api/pricing
COINGECKO_DEMO_KEY=

# ── Optional — FRED API key (macro data: VIX, yields, CPI) ──────────────────
# Free. Get yours at https://fred.stlouisfed.org/docs/api/api_key.html
# Enables: GET /macro/snapshot and /macro/context endpoints
# Also used to enrich AI analysis context with macro regime info.
FRED_API_KEY=

# ── App settings ─────────────────────────────────────────────────────────────
DEBUG=false
CORS_ORIGINS=["http://localhost:3000"]

# ── Database ──────────────────────────────────────────────────────────────────
# SQLite for local dev. For Postgres: postgresql+psycopg2://user:pass@host/db
DATABASE_URL=sqlite:///./pulsetrader.db

# ── Sentiment engine ──────────────────────────────────────────────────────────
# vader   (default) — fast, local, no extra deps
# finbert — finance-tuned transformer, ~500MB download, needs: pip install ".[finbert]"
# claude  — best quality, costs tokens, requires ANTHROPIC_API_KEY
SENTIMENT_ENGINE=vader

# ── Pulse Score weights (must sum to 1.0) ─────────────────────────────────────
SCORE_WEIGHT_TECHNICAL=0.40
SCORE_WEIGHT_SENTIMENT=0.30
SCORE_WEIGHT_MOMENTUM=0.20
SCORE_WEIGHT_AI=0.10

# ── Claude model (haiku is cheapest) ─────────────────────────────────────────
CLAUDE_MODEL=claude-haiku-4-5-20251001

# ── AI cost guardrail — daily spend cap (USD) ─────────────────────────────────
# Set to 0 to disable entirely (unlimited). Resets at midnight UTC.
# When exceeded, Claude endpoints return HTTP 429 with spend details.
DAILY_TOKEN_BUDGET_USD=5.00

# ── Logging ───────────────────────────────────────────────────────────────────
# DEBUG=true enables verbose logging (including SQL queries)
DEBUG=false
